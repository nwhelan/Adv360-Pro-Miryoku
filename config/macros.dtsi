macro_codegen1: macro_codegen1{
compatible = "zmk,behavior-macro";
label = "macro_codegen1";
#binding-cells = <0>;
bindings = <&kp AT_SIGN>, <&kp COLON>, <&kp DOWN_ARROW>, <&kp LEFT>, <&kp LEFT>;
};
macro_pipe: macro_pipe{
compatible = "zmk,behavior-macro";
label = "macro_pipe";
#binding-cells = <0>;
bindings = <&kp LS(RA(BACKSLASH))>;
};
macro_backslash: macro_backslash{
compatible = "zmk,behavior-macro";
label = "macro_backslash";
#binding-cells = <0>;
bindings = <&kp RA(BACKSLASH)>;
};
macro_copyq: macro_copyq{
compatible = "zmk,behavior-macro";
label = "macro_copyq";
#binding-cells = <0>;
bindings = <&kp LC(LS(LA(Q)))>;
};
macro_pound: macro_pound{
compatible = "zmk,behavior-macro";
label = "macro_pound";
#binding-cells = <0>;
bindings = <&kp LS(LC(4))>;
};
macro_powerrun: macro_powerrun{
compatible = "zmk,behavior-macro";
